{
  "appId": "app.seenapp.ios",
  "appName": "Seen",
  "webDir": "dist",
  "backgroundColor": "#ffffff",
  "ios": {
    "contentInset": "never",
    "scrollEnabled": false,
    "backgroundColor": "#ffffff"
  },
  "plugins": {
    "PushNotifications": {
      "presentationOptions": ["alert", "sound", "badge"]
    },
    "FirebaseAuthentication": {
      "skipNativeAuth": true,
      "providers": ["google.com", "apple.com"]
    }
  }
}
