rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "prince1489@googlemail.com";
    }

    // ── Public messages (global greeting feed) ──
    match /publicMessages/{msgId} {
      allow read: if true;
      allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
          && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid || isAdmin());

      match /reactions/{reactionId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null
            && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      }

      match /gifts/{giftId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if isAdmin();
      }
    }

    // ── User profiles ──
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.auth.uid == userId;
      // Owner can update freely. Another authenticated user may update only the
      // sparkBalance field (powers spark gifts + community-greeting author rewards).
      allow update: if request.auth != null && (
          request.auth.uid == userId
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sparkBalance'])
      );
      allow delete: if isAdmin();

      // Denormalized live heart feed — written by the reactor, read by the owner
      match /reactionsReceived/{reactionId} {
        allow read: if request.auth.uid == userId || isAdmin();
        allow create, update: if request.auth != null
            && request.resource.data.reactorUid == request.auth.uid
            && request.resource.data.ownerUid == userId;
        // resource == null guard covers pre-migration un-hearts where the doc may not exist
        allow delete: if request.auth != null
            && (resource == null || resource.data.reactorUid == request.auth.uid)
            || isAdmin();
      }

      // My own log of greetings I reacted to — private to me, powers ripple credit
      match /outgoingReactions/{msgId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Ripple credits — "people my kindness sparked into greeting others".
      // Written by the responder (who reacted then greeted), read by the originator.
      match /ripples/{responderUid} {
        allow read: if request.auth.uid == userId || isAdmin();
        allow create, update: if request.auth != null
            && request.resource.data.responderUid == request.auth.uid
            && request.resource.data.originatorUid == userId;
        allow delete: if isAdmin();
      }

      // Blocked users — private to the owner only
      match /blockedUsers/{blockedUid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Gratitude & kindness journal — private to the owner only
      match /journal/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Wellbeing check-ins — private to the owner only, for the user's own reflection.
      // Create validates the check-in shape (raw score 0–25). Not used for clinical
      // screening, monitoring or efficacy claims.
      match /wellbeing/{id} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
            && request.resource.data.scores is map
            && request.resource.data.who5Raw is number
            && request.resource.data.who5Raw >= 0
            && request.resource.data.who5Raw <= 25;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Encouragement replies to my feeling status — written by the responder,
      // read only by me (replies are private; the feed shows just a counter).
      match /feelingReplies/{replyId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null
            && request.resource.data.responderUid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 120;
        // The reply id is deterministic (one per responder per feeling), so re-sending overwrites
        // the SAME doc — that's an update, not a create. Let the original responder revise their
        // own reply so a repeat send never fails with "couldn't send".
        allow update: if request.auth != null
            && resource.data.responderUid == request.auth.uid
            && request.resource.data.responderUid == request.auth.uid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 120;
        allow delete: if request.auth != null && request.auth.uid == userId || isAdmin();
      }

      // Kindness echoes — "your encouragement helped". Written by the feeling's
      // poster when they acknowledge, read only by the responder it belongs to.
      match /kindnessEchoes/{echoId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow create: if request.auth != null
            && request.resource.data.fromUid == request.auth.uid
            && request.resource.data.ownerUid == userId;
        allow delete: if request.auth != null && request.auth.uid == userId || isAdmin();
      }
    }

    // ── Presence (ephemeral heartbeat) ──
    // Shared reflections — a journal entry the author chose to share to the feed.
    //
    // Readable by ANY signed-in user, deliberately: the follow graph lives in localStorage
    // (seen_v2_follows), so "only the people who follow me" cannot be enforced server-side.
    // The feed filters by follow client-side, and the share sheet says plainly that other
    // members can see it rather than implying a privacy guarantee we cannot keep.
    match /sharedReflections/{reflectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
      allow delete: if request.auth != null
          && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    match /presence/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
          && request.auth.uid == userId;
      allow delete: if request.auth != null
          && (request.auth.uid == userId || isAdmin());
    }

    // ── Waves (wave-back notifications) ──
    match /waves/{waveId} {
      allow read: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
           || resource.data.toUid   == request.auth.uid
           || isAdmin());
      allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
          && resource.data.toUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Community greeting submissions ──
    match /greetingSubmissions/{id} {
      allow read: if request.auth != null;
      // Submissions are created ONLY by the AI-moderation endpoint (Admin SDK, which bypasses
      // rules) — never directly by a client — so an unmoderated/inappropriate greeting can't be
      // written straight to Firestore. isAdmin() keeps a manual console path.
      allow create: if isAdmin();
      // Anyone else may only touch the vote / report / sent counters — never status or text.
      allow update: if request.auth != null && (
          isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['upvotes','voters','reportCount','reporters','sentCount'])
      );
      allow delete: if isAdmin();
    }

    // ── Reports (admin-only read) ──
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // ── Feeling statuses (the Kindness Loop's "see a real need") ──
    // One active feeling per user: the doc id IS the poster's uid, so posting again
    // overwrites. Everyone signed-in can read (the feed strip); only the owner can
    // create/update their status — except responders, who may bump replyCount only.
    match /feelings/{posterUid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.auth.uid == posterUid
          && request.resource.data.uid == posterUid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 60
          && request.resource.data.visibility in ['open', 'anon'];
      allow update: if request.auth != null && (
          (request.auth.uid == posterUid
            && request.resource.data.uid == posterUid
            && request.resource.data.text is string
            && request.resource.data.text.size() <= 60
            && request.resource.data.visibility in ['open', 'anon'])
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['replyCount'])
      );
      allow delete: if request.auth != null
          && (request.auth.uid == posterUid || isAdmin());
    }

    // ── App-wide state (reset signal etc.) ──
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
