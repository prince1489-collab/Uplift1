rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "prince1489@googlemail.com";
    }

    // ── Public messages (global greeting feed) ──
    match /publicMessages/{msgId} {
      allow read: if true;
      allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid;
      allow update: if request.auth != null
          && resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid || isAdmin());

      match /reactions/{reactionId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null
            && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      }

      match /gifts/{giftId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if isAdmin();
      }
    }

    // ── User profiles ──
    match /users/{userId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.auth.uid == userId;
      // Owner can update freely. Another authenticated user may update only the
      // sparkBalance field (powers spark gifts + community-greeting author rewards).
      allow update: if request.auth != null && (
          request.auth.uid == userId
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sparkBalance'])
      );
      allow delete: if isAdmin();

      // Denormalized live heart feed — written by the reactor, read by the owner
      match /reactionsReceived/{reactionId} {
        allow read: if request.auth.uid == userId || isAdmin();
        allow create, update: if request.auth != null
            && request.resource.data.reactorUid == request.auth.uid
            && request.resource.data.ownerUid == userId;
        // resource == null guard covers pre-migration un-hearts where the doc may not exist
        allow delete: if request.auth != null
            && (resource == null || resource.data.reactorUid == request.auth.uid)
            || isAdmin();
      }

      // My own log of greetings I reacted to — private to me, powers ripple credit
      match /outgoingReactions/{msgId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Ripple credits — "people my kindness sparked into greeting others".
      // Written by the responder (who reacted then greeted), read by the originator.
      match /ripples/{responderUid} {
        allow read: if request.auth.uid == userId || isAdmin();
        allow create, update: if request.auth != null
            && request.resource.data.responderUid == request.auth.uid
            && request.resource.data.originatorUid == userId;
        allow delete: if isAdmin();
      }

      // Blocked users — private to the owner only
      match /blockedUsers/{blockedUid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Gratitude & kindness journal — private to the owner only
      match /journal/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Wellbeing check-ins — private to the owner only. Create validates the WHO-5 shape
      // (raw score 0–25) so stored data stays exportable for research/efficacy claims.
      match /wellbeing/{id} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
            && request.resource.data.scores is map
            && request.resource.data.who5Raw is number
            && request.resource.data.who5Raw >= 0
            && request.resource.data.who5Raw <= 25;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Presence (ephemeral heartbeat) ──
    match /presence/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
          && request.auth.uid == userId;
      allow delete: if request.auth != null
          && (request.auth.uid == userId || isAdmin());
    }

    // ── Waves (wave-back notifications) ──
    match /waves/{waveId} {
      allow read: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
           || resource.data.toUid   == request.auth.uid
           || isAdmin());
      allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
          && resource.data.toUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Circles (private invite-only groups) ──
    match /circles/{circleId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.ownerUid == request.auth.uid;
      allow update: if request.auth != null
          && resource.data.ownerUid == request.auth.uid;
      allow delete: if request.auth != null
          && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /messages/{messageId} {
        allow read: if request.auth != null;
        allow create: if request.auth != null;
        allow delete: if request.auth != null
            && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // ── Circle invites ──
    match /circleInvites/{inviteId} {
      allow read: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
           || resource.data.toUid  == request.auth.uid);
      allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
           || resource.data.toUid  == request.auth.uid)
          || isAdmin();
    }

    // ── Community greeting submissions ──
    match /greetingSubmissions/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.status == "pending"
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 120;
      // Admin moderates (status/approval). Anyone else may only touch the
      // vote / report / sent counters — never status or text.
      allow update: if request.auth != null && (
          isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['upvotes','voters','reportCount','reporters','sentCount'])
      );
      allow delete: if isAdmin();
    }

    // ── Chat requests ──
    match /chatRequests/{requestId} {
      allow read: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
           || resource.data.toUid   == request.auth.uid
           || isAdmin());
      allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid;
      allow update, delete: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
           || resource.data.toUid   == request.auth.uid)
          || isAdmin();
    }

    // ── Private chats ──
    match /privateChats/{chatId} {
      allow read, update: if request.auth != null
          && (request.auth.uid in resource.data.participants || isAdmin());
      allow create: if request.auth != null
          && request.auth.uid in request.resource.data.participants;
      allow delete: if isAdmin();

      match /messages/{messageId} {
        allow read: if request.auth != null && (
          request.auth.uid in get(/databases/$(database)/documents/privateChats/$(chatId)).data.participants
          || isAdmin()
        );
        allow create: if request.auth != null
            && request.resource.data.senderUid == request.auth.uid;
        allow delete: if request.auth != null
            && (resource.data.senderUid == request.auth.uid || isAdmin());
      }
    }

    // ── Reports (admin-only read) ──
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // ── App-wide state (reset signal etc.) ──
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
