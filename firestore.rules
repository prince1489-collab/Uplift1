rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null
          && request.auth.token.email == "prince1489@googlemail.com";
    }

    // ── Public messages (global greeting feed) ──
    match /publicMessages/{msgId} {
      allow read: if true;
      // The world-readable collection had NO bound on `text` at all, while its quieter neighbours
      // both do (privateReplies 500, sharedReflections 2000) — so a client talking straight to
      // Firestore could put a megabyte into the feed everyone loads.
      //
      // 500 rather than the composer's 200 on purpose. This is the abuse ceiling, not the product
      // limit: the real contract is that api/moderate-message.js reads at most 200 characters, and
      // that is enforced where it belongs, in the composer. Pinning the rule to 200 as well would
      // mean a preset or a proverb that grew by a word became a permission error.
      allow create: if request.auth != null
          && request.resource.data.uid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500;
      // ── Editing your own post ──
      //
      // This used to be `uid == request.auth.uid` and nothing else, which meant the author could
      // rewrite ANY field from a console: the text, the sparkReward, the timestamp. Nobody did,
      // because the app offered no button — but the text half of that is a MODERATION BYPASS,
      // and a big one. Post something warm, then rewrite it to anything, and
      // api/moderate-message.js never sees the words that end up in the feed. An edit feature is
      // the reason to close it rather than the reason it opened.
      //
      // Three keys, and nothing else:
      //   text      — the edit itself, held to the same 500-character abuse ceiling as a create
      //   editedAt  — the marker (see below)
      //   hasMedia  — set by Feed2 immediately after a GIF attaches, on a post it just created
      //
      // `sparkReward` is deliberately NOT in that list. It is what handleDeleteMessage claws
      // back, so a writable one would let somebody inflate a post's value and then delete it for
      // a refund of drops they never earned.
      //
      // AND THE MARKER CANNOT BE SKIPPED. If `text` changes, `editedAt` must change with it.
      // That is enforced here rather than trusted to the client because the marker is the whole
      // protection for anyone who already reacted: their heart stays on the post, so the post
      // has to be honest that it is not the post they hearted. A client that could quietly amend
      // the words and leave no trace would make the marker decorative.
      allow update: if request.auth != null
          && resource.data.uid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['text', 'editedAt', 'hasMedia'])
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          && (request.resource.data.text == resource.data.text
              || request.resource.data.diff(resource.data).affectedKeys().hasAny(['editedAt']));
      allow delete: if request.auth != null
          && (resource.data.uid == request.auth.uid || isAdmin());

      match /reactions/{reactionId} {
        allow read: if true;
        allow create, update: if request.auth != null;
        allow delete: if request.auth != null
            && (resource == null || resource.data.uid == request.auth.uid || isAdmin());
      }

      match /gifts/{giftId} {
        allow read: if true;
        allow create: if request.auth != null;
        allow delete: if isAdmin();
      }

      // ── Attached media (GIFs now; photos later) ──
      //
      // THIS IS THE ONE PLACE IN THE FEED THAT IS NOT WORLD-READABLE, and that is the whole
      // reason it is a subcollection rather than two more fields on the message.
      //
      // The requirement is "only people in your Focused Feed can see them". Its neighbours above
      // are all `allow read: if true`, and the Worldwide/Focused split is drawn in the client —
      // which makes it a presentation choice, not a boundary. Anyone can point the SDK at
      // publicMessages and read every document in it. Keeping media on the message document and
      // filtering in the feed would have looked identical in the app while being worth nothing
      // to the person who was promised it.
      //
      // Your Focused Feed is the people YOU follow, so the question is whether the READER follows
      // the AUTHOR — users/{reader}/follows/{author}. exists() in a rule is not bound by that
      // path's own owner-only read rule, so this works without opening anyone's follow list.
      //
      // The cost is one document read per media item shown. That is why media lives here and the
      // message carries only a `hasMedia` flag: a feed of ordinary text messages pays nothing,
      // and the client only ever asks for this document when there is something to fetch.
      match /media/{mediaId} {
        allow read: if request.auth != null
            && (resource.data.uid == request.auth.uid
                || exists(/databases/$(database)/documents/users/$(request.auth.uid)/follows/$(resource.data.uid))
                || isAdmin());

        // The URL is pinned to the GIF provider's own domain. Without this, "attach a GIF" is a
        // field that accepts any URL a client cares to write — a tracking pixel that fires on
        // every viewer, a host that logs the IP of everyone who follows you, or an image swapped
        // for something else after moderation. The app never needs another host, so the rule
        // says so, and the whole safety argument for GIFs (someone else rates the catalogue)
        // only holds while the bytes really do come from that catalogue.
        //
        // ── CONFIRMED IN PRODUCTION, AND DELIBERATELY NOT NARROWER ───────────────────────────
        // This was pinned to Tenor until Google shut that API down, and when it was repointed at
        // Klipy their docs were unreachable, so the registrable domain was a considered guess
        // rather than a verified host. It has since been confirmed the only way that counts: a
        // real GIF attached and rendered in the live feed, which it could not have done if this
        // create rule had refused the write.
        //
        // It stays at the registrable domain rather than tightening to the exact subdomain that
        // was observed. A CDN is free to answer from media1, media2, cdn or anything else on any
        // given day, and pinning to one of those buys nothing — Klipy already controls every
        // name under klipy.com, so narrowing WITHIN their domain protects against nobody, while
        // a subdomain that rotates would break attachments intermittently and look like a bug in
        // the picker. The boundary that matters is "their domain, not an arbitrary one", and that
        // is exactly what this expresses.
        //
        // Failing closed remains deliberate: if the host were ever wrong the media write is
        // rejected, and Feed2 treats a failed GIF attach as "the post stands without it" rather
        // than losing the words. A wrong pin costs a missing GIF, never a lost post.
        allow create: if request.auth != null
            && request.resource.data.uid == request.auth.uid
            && request.resource.data.type == "gif"
            && request.resource.data.url is string
            && request.resource.data.url.matches('https://[a-z0-9.-]+[.]klipy[.]com/.*')
            && request.resource.data.previewUrl is string
            && request.resource.data.previewUrl.matches('https://[a-z0-9.-]+[.]klipy[.]com/.*');

        // No update: a media item is written once with its message. Allowing edits would let a
        // published, already-seen GIF be swapped for another one after the fact.
        allow delete: if request.auth != null
            && (resource.data.uid == request.auth.uid || isAdmin());
      }
    }

    // ── User profiles ──
    // The private profile. Holds email, date of birth, WHO-5 wellbeing scores, FCM push
    // token and timezone — so reads are the OWNER only (plus admin). This used to be
    // readable by any signed-in account, which was survivable only while there was no way
    // to enumerate members. Search-to-follow removes that, so the fields other people
    // legitimately need moved to /publicProfiles and this one closed.
    //
    // Cross-user WRITES of sparkBalance still work (gifts, referral and community-greeting
    // rewards): they use increment(), which needs no read. See src/publicProfile.js.
    match /users/{userId} {
      allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
      allow create: if request.auth != null
          && request.auth.uid == userId;
      // Owner can update freely. Another authenticated user may update only the
      // sparkBalance field (powers spark gifts + community-greeting author rewards).
      allow update: if request.auth != null && (
          request.auth.uid == userId
          || request.resource.data.diff(resource.data).affectedKeys().hasOnly(['sparkBalance'])
      );
      allow delete: if isAdmin();

      // Denormalized live heart feed — written by the reactor, read by the owner
      match /reactionsReceived/{reactionId} {
        allow read: if request.auth.uid == userId || isAdmin();
        allow create, update: if request.auth != null
            && request.resource.data.reactorUid == request.auth.uid
            && request.resource.data.ownerUid == userId;
        // resource == null guard covers pre-migration un-hearts where the doc may not exist
        allow delete: if request.auth != null
            && (resource == null || resource.data.reactorUid == request.auth.uid)
            || isAdmin();
      }

      // My own log of greetings I reacted to — private to me, powers ripple credit
      match /outgoingReactions/{msgId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Ripple credits — "people my kindness sparked into greeting others".
      // Written by the responder (who reacted then greeted), read by the originator.
      match /ripples/{responderUid} {
        allow read: if request.auth.uid == userId || isAdmin();
        allow create, update: if request.auth != null
            && request.resource.data.responderUid == request.auth.uid
            && request.resource.data.originatorUid == userId;
        allow delete: if isAdmin();
      }

      // Blocked users — private to the owner only
      match /blockedUsers/{blockedUid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Who I follow — private to the owner only, same shape as blockedUsers.
      //
      // Follows used to live in localStorage, which meant signing in on a second device gave
      // you an empty Focused Feed and no way to get the list back. They are an account fact,
      // not a device fact.
      //
      // Owner-only reads matter: who you choose to follow is not something other members
      // should be able to enumerate. The doc id is the followed uid, so following twice
      // overwrites rather than duplicating.
      match /follows/{followedUid} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Gratitude & kindness journal — private to the owner only
      match /journal/{entryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Wellbeing check-ins — private to the owner only, for the user's own reflection.
      // Create validates the check-in shape (raw score 0–25). Not used for clinical
      // screening, monitoring or efficacy claims.
      match /wellbeing/{id} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create: if request.auth != null && request.auth.uid == userId
            && request.resource.data.scores is map
            && request.resource.data.who5Raw is number
            && request.resource.data.who5Raw >= 0
            && request.resource.data.who5Raw <= 25;
        allow update, delete: if request.auth != null && request.auth.uid == userId;
      }

      // Encouragement replies and kindness echoes — both belonged to the "how you're
      // feeling" loop, removed in the V2 review pass. Reads stay open to the owner because
      // the Kindness Board still builds their history from these documents; creates are
      // closed because nothing writes them any more.
      match /feelingReplies/{replyId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId;
      }

      match /kindnessEchoes/{echoId} {
        allow read: if request.auth != null && (request.auth.uid == userId || isAdmin());
        allow write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Presence (ephemeral heartbeat) ──
    // Private replies — a direct message from one member to another, in response to a
    // specific feed message. The tightest read rule in this file: ONLY the two people
    // involved can ever read it, unlike sharedReflections (any signed-in member) or
    // publicMessages (world-readable).
    //
    // No update path for `text` — a reply cannot be edited after it has been delivered, so
    // what the recipient reports is what was sent. The recipient may only flip `read`.
    //
    // ONE REPLY BACK, AND ONLY ONE — enforced here rather than by hiding a button.
    //
    // The exchange is deliberately capped at two messages: B replies to A's public message,
    // A may answer once, and that is the end. Not a chat. Two mechanisms make that real
    // server-side, so it holds against anything talking to Firestore directly:
    //
    //  1. The answer is written at a DERIVED id — `{originalReplyId}__reply` — rather than a
    //     random one. In Firestore a write to a path that already holds a document is an
    //     UPDATE, not a create, so a second answer falls through to the update rule below,
    //     which permits only `read` to change. The cap therefore needs no counter, no
    //     transaction and no extra document: it is a consequence of the id being predictable.
    //
    //  2. An answer cannot itself be answered. `inReplyTo` must not already end in
    //     `__reply`, which stops `x__reply__reply` and every longer chain.
    //
    // `matches()` is a full-string match in rules, so '.*__reply' means "ends with __reply".
    match /privateReplies/{replyId} {
      allow read: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
              || resource.data.toUid == request.auth.uid);
      allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid
          && request.resource.data.toUid is string
          && request.resource.data.toUid != request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 500
          // A first reply carries no inReplyTo and keeps its auto-id. An answer must carry
          // one, must sit at the id derived from it, and must not be answering an answer.
          && (!('inReplyTo' in request.resource.data.keys())
              || (request.resource.data.inReplyTo is string
                  && replyId == request.resource.data.inReplyTo + '__reply'
                  && !request.resource.data.inReplyTo.matches('.*__reply')));
      allow update: if request.auth != null
          && resource.data.toUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read']);
      allow delete: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
              || resource.data.toUid == request.auth.uid
              || isAdmin());
    }

    // Shared reflections — a journal entry the author chose to share to the feed.
    //
    // Readable by ANY signed-in user, deliberately: the follow graph lives in localStorage
    // (seen_v2_follows), so "only the people who follow me" cannot be enforced server-side.
    // The feed filters by follow client-side, and the share sheet says plainly that other
    // members can see it rather than implying a privacy guarantee we cannot keep.
    match /sharedReflections/{reflectionId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.authorUid == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() > 0
          && request.resource.data.text.size() <= 2000;
      allow delete: if request.auth != null
          && (resource.data.authorUid == request.auth.uid || isAdmin());
    }

    match /presence/{userId} {
      allow read: if true;
      allow create, update: if request.auth != null
          && request.auth.uid == userId;
      allow delete: if request.auth != null
          && (request.auth.uid == userId || isAdmin());
    }

    // ── Waves (wave-back notifications) ──
    match /waves/{waveId} {
      allow read: if request.auth != null
          && (resource.data.fromUid == request.auth.uid
           || resource.data.toUid   == request.auth.uid
           || isAdmin());
      allow create: if request.auth != null
          && request.resource.data.fromUid == request.auth.uid;
      allow update: if request.auth != null
          && resource.data.toUid == request.auth.uid;
      allow delete: if isAdmin();
    }

    // ── Community greeting submissions ──
    match /greetingSubmissions/{id} {
      allow read: if request.auth != null;
      // Submissions are created ONLY by the AI-moderation endpoint (Admin SDK, which bypasses
      // rules) — never directly by a client — so an unmoderated/inappropriate greeting can't be
      // written straight to Firestore. isAdmin() keeps a manual console path.
      allow create: if isAdmin();
      // Anyone else may only touch the vote / report / sent counters — never status or text.
      allow update: if request.auth != null && (
          isAdmin()
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['upvotes','voters','reportCount','reporters','sentCount'])
      );
      allow delete: if isAdmin();
    }

    // ── Reports (admin-only read) ──
    match /reports/{reportId} {
      allow create: if request.auth != null;
      allow read, update, delete: if isAdmin();
    }

    // ── Feeling statuses ──
    // The "how you're feeling" feature was removed in the V2 review pass. Writes are closed
    // so no new status can be created, but existing docs stay readable by their owner (and
    // admin) rather than being orphaned behind a rule that denies everything.
    match /feelings/{posterUid} {
      allow read: if request.auth != null && (request.auth.uid == posterUid || isAdmin());
      allow write: if isAdmin();
    }

    // ── Referrals ──
    // A one-time "this account was referred, and the reward has been paid" marker. The doc id
    // IS the new user's uid, which is what makes it idempotent — the award transaction reads
    // it first and bails if it exists.
    //
    // This collection had NO rule until scripts/check-rules.cjs went looking, which means the
    // referral reward transaction has been denied for every user who ever arrived through an
    // invite link. It failed into a console.error and nobody saw it.
    //
    // Create only, only by the account being referred, and only naming itself. No update and
    // no delete: this document existing is the thing that stops a referral paying out twice,
    // so letting anyone edit or remove it would reopen exactly that.
    match /referrals/{newUserUid} {
      allow read: if request.auth != null && request.auth.uid == newUserUid;
      allow create: if request.auth != null
          && request.auth.uid == newUserUid
          && request.resource.data.newUserUid == newUserUid
          && request.resource.data.referrerUid is string
          && request.resource.data.referrerUid != newUserUid;
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Kind moments ──
    // "A private message of kindness happened" — and nothing else. No names, no text, no
    // message id. The two uids are stored so the client can decide which feed to show the
    // card in; they are never rendered, and the rule below is what stops that from being a
    // loophole rather than a convention.
    //
    // Readable by any signed-in member — that is the entire point of the card. Create-only:
    // a moment is a fact about the past, so there is nothing to edit. Only the person who
    // SENT the reply may write one, and only naming themselves as the sender, which stops
    // anyone manufacturing moments about other people.
    match /kindMoments/{momentId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
          && request.resource.data.aUid == request.auth.uid
          && request.resource.data.bUid is string
          && request.resource.data.bUid != request.auth.uid
          && request.resource.data.ts is number
          // Belt and braces: refuse a document that carries anything beyond these five keys,
          // so a future caller cannot quietly start attaching names or message text.
          && request.resource.data.keys().hasOnly(['aUid','bUid','aCountry','bCountry','ts']);
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ── Public profiles ──
    // The readable projection of a member's profile: display name, country, avatar, the two
    // glimpse lines, and the reactions-received tally. Every one of those is already shown
    // in the app to anyone who can see one of your messages — the point of this collection
    // is that nothing ELSE travels with them.
    //
    // Readable by any signed-in member (that's what makes search and the glimpse card work);
    // writable only by its owner, and only with their own uid on the document.
    match /publicProfiles/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
          && request.auth.uid == uid
          && request.resource.data.uid == uid;
    }

    // ── App-wide state (reset signal etc.) ──
    match /meta/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
