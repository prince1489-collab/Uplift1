{
  "crons": [
    { "path": "/api/send-reminder", "schedule": "0 9 * * *" },
    { "path": "/api/send-reminder", "schedule": "0 15 * * *" },
    { "path": "/api/send-reminder", "schedule": "0 21 * * *" }
  ],
  "rewrites": [
    { "source": "/privacy", "destination": "/privacy.html" },
    { "source": "/delete-account", "destination": "/delete-account.html" },
    { "source": "/child-safety", "destination": "/child-safety.html" }
  ],
  "headers": [
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma",        "value": "no-cache" },
        { "key": "Expires",       "value": "0" }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" }
      ]
    }
  ]
}
